<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to hidden files/folders (.env, .git, etc.)
    RewriteRule (^\.|/\.) - [F]

    # Block direct access to internal Laravel directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L]

    # Silently forward all requests to /public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes
